# ── T1V-APP port registry ─────────────────────────────────────────────
# Single place to manage every localhost port this project uses.
# Read by src/ports.js (Electron main) and ui/vite.config.js (dev server).

# Overlay HTTP server (Electron main serves ui/dist + /auth /f1 /tts /fonts)
OVERLAY_PORT=47200

# Vite dev server for the overlay UI (hot reload during development)
UI_DEV_PORT=5174

# Default overlay URL for OBS / preview (production build served by the app;
# point it at http://localhost:5174/ manually while developing the overlay)
OVERLAY_URL=http://localhost:47200/

# OBS WebSocket default (external app — must match OBS settings)
OBS_PORT=4455

# OAuth redirect ports — must match redirect URIs registered in each
# developer portal; don't change without updating the portal too.
YOUTUBE_REDIRECT_PORT=8985
TIKTOK_REDIRECT_PORT=8986
FB_REDIRECT_PORT=8986
TWITCH_REDIRECT_PORT=80
KICK_REDIRECT_PORT=80

# Chrome remote-debugging ports (cookie import / sign-in helpers)
DEBUG_PORT_COOKIE_IMPORT=9223
DEBUG_PORT_GOOGLE_SIGNIN=9224
DEBUG_PORT_SITE_LOGIN=9225
