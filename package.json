{
  "name": "t1v-app",
  "version": "1.0.0",
  "description": "T1V central dashboard for F1 content workflow",
  "main": "src/main.js",
  "scripts": {
    "dev": "concurrently \"cd ui && npm run dev\" \"npm start\"",
    "start": "node launch.js",
    "build:overlay": "cd ui && npm run build",
    "build": "npm run build:overlay && electron-builder --win --x64"
  },
  "keywords": [],
  "author": "TURN1VISUALS",
  "license": "ISC",
  "build": {
    "appId": "com.turn1visuals.t1v-app",
    "productName": "T1V",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "files": [
      "src/**/*",
      "ui/dist/**/*",
      "assets/**/*",
      "launch.js",
      "package.json"
    ],
    "extraResources": []
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "electron": "^33.4.11",
    "electron-builder": "^26.8.1"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.2.0",
    "@huggingface/transformers": "^3.8.1",
    "kokoro-js": "^1.2.1",
    "obs-websocket-js": "^5.0.7",
    "simple-icons": "^16.11.0",
    "sql.js": "^1.14.1",
    "ws": "^8.19.0"
  }
}
